{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow — gestor de tareas colaborativo. Proyecto del curso de Testing y Calidad de Software.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:setup",
    "db:reset": "npm --prefix server run db:reset",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "e2e:server": "node e2e/start-api.mjs",
    "lint": "npm --prefix server run lint",
    "postinstall": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "20.19.9",
    "concurrently": "9.1.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
